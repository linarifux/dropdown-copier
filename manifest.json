{
  "manifest_version": 3,
  "name": "Copy Dropdown Text",
  "version": "1.0",
  "description": "Right-click any dropdown list to copy all its options.",
  "permissions": [
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}